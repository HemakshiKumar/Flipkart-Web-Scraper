# Copy to backend/.env to override any of these.

# --- service ---
HOST=127.0.0.1
PORT=8000
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000

# --- limits ---
MAX_RECOMMENDATIONS=50
MAX_QUERY_LENGTH=120
MAX_REQUIREMENTS_LENGTH=500

# --- scraping ---
SCRAPING_ENABLED=true
MAX_PRODUCTS_PER_SEARCH=24
SCRAPE_CONCURRENCY=8
REQUEST_TIMEOUT=15

# Override the Flipkart CSS selectors without touching the code when Flipkart
# changes its markup. JSON object, merged over the defaults in app/config.py.
# FLIPKART_SELECTORS={"product_link": {"tag": "a", "class": "wjcEIp"}}

# --- dataset ---
CACHE_TTL_SECONDS=21600
SEED_DATASET_FALLBACK=true

# --- ranking weights (normalised at runtime) ---
WEIGHT_SIMILARITY=0.70
WEIGHT_RATING=0.20
WEIGHT_POPULARITY=0.10
